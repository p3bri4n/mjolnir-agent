# Absolute path to the workspace folder on the HOST (not inside a
# container). Required by mcp-client, which mounts this path into the
# containers it spawns via the Docker socket.
WORKSPACE_HOST_PATH=/absolute/path/to/workspace

# Absolute path to the folder holding model weights. Optional -- defaults
# to ./models (relative to docker-compose.yml). Useful to store large
# weights on a separate disk.
MODELS_HOST_PATH=/absolute/path/to/models

# Inference backend URL (OpenAI-compatible). Optional -- defaults to
# TabbyAPI (http://tabbyapi:5000/v1, see services/tabbyapi/config.yml).
LLM_BASE_URL=http://tabbyapi:5000/v1

# Retries before giving up on an empty/malformed tool-call response (a
# model occasionally writes its call as prose instead of a structured
# tool_calls the server recognizes).
MAX_EMPTY_ANSWER_RETRIES=1

# Fixed key for Open WebUI (session cookies, secret encryption). Without a
# fixed value, every container recreation invalidates every session.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_ME_openssl_rand_hex_32

# Dashboard port on the host.
DASHBOARD_PORT=8090

# GPU VRAM stats on the dashboard (nvidia-smi). Requires uncommenting the
# dashboard service's "deploy" block in docker-compose.yml too.
ENABLE_GPU_STATS=false

# Advanced / rarely needed, not listed here to keep this file short:
# IMAGE_FORMAT_PASSTHROUGH, ADAPTIVE_THINKING (docs/architecture/
# inference-backend.md), the cognitive-core flags PLANNER_ENABLED/
# VERIFICATION_ENABLED/SUBTASK_ATTEMPT_BUDGET/REPLAN_BUDGET/
# PLAN_VALIDATION_ENABLED/PLAN_JUDGE_ENABLED/PLANNER_MAX_TOKENS
# (docs/architecture/autonomy.md), IMAGE_TOKEN_ESTIMATE. All have working
# defaults; set any of them directly in .env only if you have a specific
# reason to override one.
