# Absolute path to the workspace folder on the HOST (not inside a
# container). Required by mcp-client, which mounts this path into the
# containers it spawns via the Docker socket.
WORKSPACE_HOST_PATH=/absolute/path/to/workspace

# Absolute path to the folder holding model weights. Optional -- defaults
# to ./models (relative to docker-compose.yml). Useful to store large
# weights on a separate disk.
MODELS_HOST_PATH=/absolute/path/to/models

# Inference backend URL (OpenAI-compatible). Optional -- defaults to
# TabbyAPI (http://tabbyapi:5000/v1, see services/tabbyapi/config.yml).
LLM_BASE_URL=http://tabbyapi:5000/v1

# Screenshot image format sent to the LLM. Empty/absent (default): always
# re-encoded to PNG -- the default backend (TabbyAPI/ExLlamaV3) is not
# known to decode WebP natively. Set to "webp" only with the llama-server
# backend (its llama.cpp fork decodes WebP natively) -- never with Ollama,
# whose decoder fails on it explicitly.
IMAGE_FORMAT_PASSTHROUGH=

# Suppress reasoning via a "/no_think" prompt prefix when the previous
# turn's tool calls were all auto-approved. Confirmed to have NO EFFECT on
# the default TabbyAPI backend (see docs/architecture/inference-backend.md)
# -- only useful with llama-server/Ollama.
ADAPTIVE_THINKING=false

# Cognitive-core flags (explicit plan / post-action verification / plan
# validation -- see docs/architecture/autonomy.md). Defaults below match
# the measured, adopted configuration (docs/project-status.md); flipping
# them is a behavioral change, not a preference.
PLANNER_ENABLED=false
VERIFICATION_ENABLED=false
SUBTASK_ATTEMPT_BUDGET=3
REPLAN_BUDGET=2
PLAN_VALIDATION_ENABLED=true
PLAN_JUDGE_ENABLED=false
# Token budget for auxiliary LLM calls (planner/verifier/judge), separate
# from the main loop's own budget -- their reasoning alone can exceed a
# budget sized for the main conversational turn.
PLANNER_MAX_TOKENS=8192

# Retries before giving up on an empty/malformed tool-call response (a
# model occasionally writes its call as prose instead of a structured
# tool_calls the server recognizes).
MAX_EMPTY_ANSWER_RETRIES=1

# Fixed key for Open WebUI (session cookies, secret encryption). Without a
# fixed value, every container recreation invalidates every session.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=REPLACE_ME_openssl_rand_hex_32

# Dashboard port on the host.
DASHBOARD_PORT=8090

# Rough per-image token estimate for the dashboard's context panel -- not
# an exact count, the served model's own vision tokenizer would be needed
# for that.
IMAGE_TOKEN_ESTIMATE=1500

# GPU VRAM stats on the dashboard (nvidia-smi). Requires uncommenting the
# dashboard service's "deploy" block in docker-compose.yml too.
ENABLE_GPU_STATS=false
